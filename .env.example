# Copy to .env (optional; these are the defaults).
DEMO_NOW=06:10
PORT=8000
# Google map. Use a key limited to the Map Tiles API and to your own website addresses. Empty = OpenStreetMap.
GOOGLE_MAPS_KEY=
# Address for the in-app "open on your phone" QR code (e.g. your Render URL). Empty = this computer on the local network.
PUBLIC_URL=
